#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
usage: scripts/local-acceptance check|run

check  validate the portable, deterministic and live acceptance contract
run    execute portable gates, wheel smoke, deterministic demo and real Host→Harness→Runtime H2 journey

Environment for run:
  ORDIVON_MCP_ENDPOINT          default http://127.0.0.1:8897/mcp
  ORDIVON_BEARER_TOKEN          optional direct ephemeral token
  ORDIVON_BEARER_TOKEN_FILE     optional private token file understood by Host scenario helpers
  ORDIVON_HARNESS_ACCEPTANCE_OUTPUT optional final live receipt path
EOF
}

repo=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
python_bin=${PYTHON_BIN:-$(command -v python3.12 || true)}
uv_bin=${UV_BIN:-$(command -v uv || true)}
uvx_bin=${UVX_BIN:-$(command -v uvx || true)}
mode=${1:-}

case "$mode" in
  check)
    test -n "$python_bin"
    test -f "$repo/scripts/demo_deterministic_run.py"
    test -f "$repo/scripts/live_harness_h2.py"
    test -f "$repo/scripts/check_dependencies.py"
    test -f "$repo/scripts/check_docs.py"
    test -f "$repo/scripts/check_evidence.py"
    test -f "$repo/scripts/check_wheel.py"
    "$python_bin" "$repo/scripts/check_dependencies.py"
    "$python_bin" "$repo/scripts/check_docs.py"
    "$python_bin" "$repo/scripts/check_evidence.py"
    printf '%s\n' 'local acceptance contract: present' 'run with: scripts/local-acceptance run'
    ;;
  run)
    test -n "$python_bin" || { echo 'Python 3.12 is required' >&2; exit 1; }
    test -n "$uv_bin" || { echo 'uv is required' >&2; exit 1; }
    test -n "$uvx_bin" || { echo 'uvx is required' >&2; exit 1; }
    cd "$repo"
    "$python_bin" -m compileall -q src tests scripts evals
    "$uvx_bin" ruff==0.15.17 check src tests scripts
    "$python_bin" -W error::ResourceWarning -m unittest discover -s tests -v
    "$python_bin" scripts/check_dependencies.py
    "$python_bin" scripts/check_docs.py
    "$python_bin" scripts/check_evidence.py
    "$uv_bin" lock --check
    "$python_bin" scripts/demo_deterministic_run.py
    wheel_dir=$(mktemp -d)
    trap 'rm -rf "$wheel_dir"' EXIT
    "$uv_bin" build --wheel --out-dir "$wheel_dir"
    "$python_bin" scripts/check_wheel.py "$wheel_dir"

    revision=$(git rev-parse HEAD)
    output=${ORDIVON_HARNESS_ACCEPTANCE_OUTPUT:-target/acceptance/harness-h2-runtime.json}
    mkdir -p "$(dirname "$output")"
    "$python_bin" scripts/live_harness_h2.py \
      --endpoint "${ORDIVON_MCP_ENDPOINT:-http://127.0.0.1:8897/mcp}" \
      --source-repo "$repo" \
      --source-revision "$revision" >"$output"
    chmod 600 "$output"
    "$python_bin" - "$output" "$revision" <<'PY'
import json,sys
path,revision=sys.argv[1:]
r=json.load(open(path,encoding='utf-8'))
assert r['kind']=='ordivon.host-h2-runtime-r2-live-receipt'
assert r['implementationSourceRevision']==revision
assert r['runtime']['workspaceClosed'] is True
assert all(r['checks'].values())
print(json.dumps({
  'status':'passed',
  'harnessRevision':revision,
  'taskId':r['taskId'],
  'harnessRunId':r['harnessRunId'],
  'runtimeJobId':r['runtime']['jobId'],
  'workspaceClosed':True,
  'payloadDigest':r['integrity']['payloadDigest'],
},sort_keys=True))
PY
    ;;
  --help|-h)
    usage
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac
