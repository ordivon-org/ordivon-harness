#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
usage: scripts/local-acceptance check|run

check  validate the current independent Harness acceptance contract
run    execute deterministic regression, repository gates, scale smoke and isolated wheel proof

Real Provider credentials are deliberately outside this portable gate. Run live Provider
acceptance explicitly when release evidence requires it.
EOF
}

repo=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
python_bin=${PYTHON_BIN:-$(command -v python3.12 || true)}
uv_bin=${UV_BIN:-$(command -v uv || true)}
uvx_bin=${UVX_BIN:-$(command -v uvx || true)}
mode=${1:-}

case "$mode" in
  check)
    test -n "$python_bin"
    for path in \
      scripts/demo_deterministic_run.py \
      scripts/check_dependencies.py \
      scripts/check_docs.py \
      scripts/check_evidence.py \
      scripts/check_wheel.py \
      scripts/check_core_without_host.py \
      scripts/harness_p0_scale_acceptance.py; do
      test -f "$repo/$path"
    done
    "$python_bin" "$repo/scripts/check_dependencies.py"
    "$python_bin" "$repo/scripts/check_docs.py"
    "$python_bin" "$repo/scripts/check_evidence.py"
    printf '%s\n' 'local acceptance contract: present' 'run with: scripts/local-acceptance run'
    ;;
  run)
    test -n "$python_bin" || { echo 'Python 3.12 is required' >&2; exit 1; }
    test -n "$uv_bin" || { echo 'uv is required' >&2; exit 1; }
    test -n "$uvx_bin" || { echo 'uvx is required' >&2; exit 1; }
    cd "$repo"
    "$python_bin" -m compileall -q src tests scripts evals
    "$uvx_bin" ruff==0.15.17 check src tests scripts
    "$uv_bin" run python -W error::ResourceWarning -m unittest discover -s tests -v
    "$python_bin" scripts/check_dependencies.py
    "$python_bin" scripts/check_docs.py
    "$python_bin" scripts/check_evidence.py
    "$uv_bin" lock --check
    "$uv_bin" run python scripts/demo_deterministic_run.py
    "$uv_bin" run python scripts/harness_p0_scale_acceptance.py \
      --runs 8 --events-per-run 12 --batch-size 11 --inspect-samples 4 \
      --max-write-ms 30000 --max-reopen-ms 30000 --max-inspect-p95-ms 1000 \
      >/dev/null
    wheel_dir=$(mktemp -d)
    trap 'rm -rf "$wheel_dir"' EXIT
    "$uv_bin" build --wheel --out-dir "$wheel_dir"
    "$python_bin" scripts/check_wheel.py "$wheel_dir"
    printf '%s\n' 'local acceptance: passed'
    ;;
  --help|-h)
    usage
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac
