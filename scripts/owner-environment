#!/usr/bin/env bash
set -euo pipefail
repo=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
mode=${1:-}
uv_bin=${UV_BIN:-$(command -v uv || true)}
env_dir=${ORDIVON_OWNER_ENV_DIR:-"$repo/.venv"}
python_bin="$env_dir/bin/python"

usage() {
  cat <<'TXT'
usage: scripts/owner-environment bootstrap|doctor|test|cold-start

bootstrap   materialize the locked Harness base + dev profile
doctor      verify installed Harness, Protocol, jsonschema, and dev tooling
test        bootstrap, doctor, lint, and run the deterministic unit suite
cold-start  prove the same test profile from a fresh temporary environment
TXT
}
require_uv() { [[ -n "$uv_bin" ]] || { echo 'Harness owner environment requires uv' >&2; exit 1; }; }
bootstrap() {
  require_uv
  UV_PROJECT_ENVIRONMENT="$env_dir" "$uv_bin" sync --frozen --group dev
}
doctor() {
  [[ -x "$python_bin" ]] || { echo "Harness owner environment is not materialized: $python_bin" >&2; exit 1; }
  "$python_bin" - <<'PY'
import importlib.metadata as md
import sys
for module in ("ordivon_harness", "ordivon_protocol", "jsonschema", "ruff"):
    __import__(module)
if sys.version_info[:2] != (3, 12):
    raise SystemExit(f"Harness requires Python 3.12, got {sys.version.split()[0]}")
if md.version("ruff") != "0.15.17":
    raise SystemExit("unexpected Ruff version")
print("owner environment doctor: valid profile=test")
PY
  (cd "$repo" && "$python_bin" scripts/check_dependencies.py)
}
run_tests() {
  bootstrap
  doctor
  cd "$repo"
  "$python_bin" -m ruff check src tests scripts
  "$python_bin" -W error::ResourceWarning -m unittest discover -s tests -q
}
case "$mode" in
  bootstrap) bootstrap ;;
  doctor) doctor ;;
  test) run_tests ;;
  cold-start)
    tmp=$(mktemp -d -t ordivon-harness-owner-env-XXXXXX)
    trap 'rm -rf "$tmp"' EXIT
    ORDIVON_OWNER_ENV_DIR="$tmp/.venv" "$0" test
    ;;
  --help|-h) usage ;;
  *) usage >&2; exit 2 ;;
esac
